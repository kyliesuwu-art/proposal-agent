# MinerU 官方 SDK Token（在 https://mineru.net/apiManage 获取）
MINERU_TOKEN=your_mineru_token_here

# 阿里百炼平台 Key，用于 embedding 和 LLM 调用。
DASHSCOPE_API_KEY=your_dashscope_api_key_here
# 可选，默认值为 DashScope OpenAI 兼容端点。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 企微长连接原型；未使用企微时可留空。
AIBOT_BOT_ID=your_aibot_bot_id_here
AIBOT_SECRET=your_aibot_secret_here

# 可选：运行数据默认均位于项目根目录。相对覆盖路径也相对项目根目录解析。
# CHROMA_PATH=chroma_db
# IMAGES_DIR=images
# DEBUG_ZIPS_DIR=debug_zips
# DEBUG_MINERU_RESULT_DIR=debug_mineru_result
# INGEST_MANIFEST_PATH=ingest_manifest.csv
